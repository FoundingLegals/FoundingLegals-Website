# ─────────────────────────────────────────────────────────────
# Founding Legals — Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real passwords, secrets, or keys to Git.
# In Production, configure these securely in the Vercel Dashboard:
# Project Settings -> Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Public Application URLs ──
NEXT_PUBLIC_APP_URL="https://app.foundinglegals.com/"
NEXT_PUBLIC_CHATBOT_API_URL="https://app.foundinglegals.com/api/chat/web"

# ── Super Admin Dashboard Authentication ──
# Required for Super Admin login at /admin/login
SUPER_ADMIN_EMAIL="info@foundinglegals.com"
SUPER_ADMIN_PASSWORD="YourStrongSecurePasswordHere"

# Optional: Secondary / Backup Admin credentials
# ADMIN_EMAIL_2="admin@foundinglegals.com"
# ADMIN_PASSWORD_2="YourSecondaryPasswordHere"

# ── Admin Session Signing Secret ──
# Used to sign HMAC tokens for admin session cookies.
# Generate a secure 32+ character random string for production.
ADMIN_SESSION_SECRET="generate_a_random_32_character_string_for_production"

# ── PostgreSQL Database Connection ──
# Managed PostgreSQL database for real-time persistent blogs, consultations & requests
DATABASE_URL="postgresql://user:password@host:25060/defaultdb?sslmode=require"
